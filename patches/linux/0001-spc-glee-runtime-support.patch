+	if (error && error != -EAGAIN)
@@ -327 +328 @@ static int silead_ts_init(struct i2c_client *client)
-	if (error)
+	if (error && error != -EAGAIN)
@@ -333 +334 @@ static int silead_ts_init(struct i2c_client *client)
-	if (error)
+	if (error && error != -EAGAIN)
@@ -339 +340 @@ static int silead_ts_init(struct i2c_client *client)
-	if (error)
+	if (error && error != -EAGAIN)
@@ -356 +357 @@ static int silead_ts_reset(struct i2c_client *client)
-	if (error)
+	if (error && error != -EAGAIN)
@@ -362 +363 @@ static int silead_ts_reset(struct i2c_client *client)
-	if (error)
+	if (error && error != -EAGAIN)
@@ -368 +369 @@ static int silead_ts_reset(struct i2c_client *client)
-	if (error)
+	if (error && error != -EAGAIN)
@@ -384 +385 @@ static int silead_ts_startup(struct i2c_client *client)
-	if (error) {
+	if (error && error != -EAGAIN) {
diff --git a/drivers/mmc/core/pwrseq_simple.c b/drivers/mmc/core/pwrseq_simple.c
index 4b47e6c3b..0d038a7bd 100644
--- a/drivers/mmc/core/pwrseq_simple.c
