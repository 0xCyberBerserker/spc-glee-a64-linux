From: SPC Glee A64 Linux contributors
Subject: [PATCH] pcm: preserve boundary and synchronize appl_ptr

Target: TinyALSA 1c5fb68ced57d838f2b7ecd0c00bc1fefc9ab60d
Apply with: git apply --unidiff-zero

---
diff --git a/src/pcm.c b/src/pcm.c
index 10e477b..96169d0 100644
--- a/src/pcm.c
+++ b/src/pcm.c
@@ -525 +525 @@ int pcm_set_config(struct pcm *pcm, const struct pcm_config *config)
-    pcm->boundary = sparams.boundary = pcm->buffer_size;
+    pcm->boundary = pcm->buffer_size;
@@ -529,0 +530,2 @@ int pcm_set_config(struct pcm *pcm, const struct pcm_config *config)
+    sparams.boundary = pcm->boundary;
+
@@ -1640 +1642,5 @@ static int pcm_generic_transfer(struct pcm *pcm, void *data,
-    if (pcm_state(pcm) == PCM_STATE_SETUP && pcm_prepare(pcm) != 0) {
+    if (pcm_sync_ptr(pcm, SNDRV_PCM_SYNC_PTR_APPL |
+                          SNDRV_PCM_SYNC_PTR_AVAIL_MIN) < 0)
+        return -1;
+
+    if (pcm->mmap_status->state == PCM_STATE_SETUP && pcm_prepare(pcm) != 0) {
